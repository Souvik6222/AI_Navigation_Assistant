<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!--
        Camera viewport: constrained to a 1:1 square.
        We pin left/right to the parent edges, and set height = width using
        dimensionRatio. This is the exact area YOLO processes (after center-crop).
        The PreviewView's fillCenter will then match this square perfectly.
    -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/floating_ui_container"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintDimensionRatio="H,1:1"
        app:scaleType="fillCenter" />

    <!-- OverlayView: MUST be exactly the same size/position as camera_preview -->
    <com.navigation.assistant.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/camera_preview"
        app:layout_constraintBottom_toBottomOf="@id/camera_preview"
        app:layout_constraintStart_toStartOf="@id/camera_preview"
        app:layout_constraintEnd_toEndOf="@id/camera_preview" />

    <!-- Floating UI Container pinned to bottom of screen, below the square viewport -->
    <LinearLayout
        android:id="@+id/floating_ui_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/rounded_bar_bg"
        android:padding="8dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_vision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vision"
                android:backgroundTint="#00000000"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:drawableTop="@android:drawable/ic_menu_camera" />

            <Button
                android:id="@+id/btn_torch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Torch"
                android:backgroundTint="#00000000"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:drawableTop="@android:drawable/ic_menu_compass" />

            <Button
                android:id="@+id/btn_logs_toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Normal Logs"
                android:backgroundTint="#00000000"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:drawableTop="@android:drawable/ic_menu_info_details" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:backgroundTint="#00000000"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:drawableTop="@android:drawable/ic_menu_preferences" />
        </LinearLayout>

        <!-- Log Section (Scrollable) -->
        <ScrollView
            android:id="@+id/log_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="#44000000"
            android:padding="8dp">

            <TextView
                android:id="@+id/log_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
