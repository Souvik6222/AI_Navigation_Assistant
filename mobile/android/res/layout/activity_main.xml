<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- CameraX PreviewView: renders the live camera feed -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- OverlayView: draws bounding boxes on top of camera -->
    <com.navigation.assistant.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating UI Container -->
    <LinearLayout
        android:id="@+id/floating_ui_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:background="@drawable/rounded_bar_bg"
        android:padding="8dp"
        android:elevation="8dp">

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_vision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vision"
                android:backgroundTint="#00000000"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:drawableTop="@android:drawable/ic_menu_camera" />

            <Button
                android:id="@+id/btn_logs_toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Normal Logs"
                android:backgroundTint="#00000000"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:drawableTop="@android:drawable/ic_menu_info_details" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Settings"
                android:backgroundTint="#00000000"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:drawableTop="@android:drawable/ic_menu_preferences" />
        </LinearLayout>

        <!-- Log Section (Scrollable) -->
        <ScrollView
            android:id="@+id/log_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="#44000000"
            android:padding="8dp">
            
            <TextView
                android:id="@+id/log_text_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </ScrollView>
    </LinearLayout>

</FrameLayout>
